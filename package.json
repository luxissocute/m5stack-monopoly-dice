{
  "name": "labu-monopoly",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Labu 玩具城市與 M5Stack 無線搖動骰子",
  "author": "Labu Toy City",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rooms": "tsx server/room-server.ts",
    "play": "node scripts/start-local.mjs",
    "desktop:build": "tsc --noEmit && vite build --mode desktop && node scripts/build-desktop.mjs && node scripts/fetch-cloudflared.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
